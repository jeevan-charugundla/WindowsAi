<Window x:Class="WindowsAICompanion.Desktop.VisualOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Loaded="OverlayWindow_Loaded">

    <!-- Root canvas covers the virtual screen; all child coordinates are overlay DIPs -->
    <Canvas x:Name="RootCanvas">

        <!-- ═══════════════════════════════════════════════════════════════
             Teaching cursor — the AI pointer that travels to the target.
             CursorCanvas is translated as a unit via Canvas.Left/Top.
             ═══════════════════════════════════════════════════════════════ -->
        <Canvas x:Name="CursorCanvas" Visibility="Collapsed" Width="32" Height="44">
            <Canvas.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.5" Direction="315"/>
            </Canvas.Effect>

            <!-- Outer pulse ring (animates scale on arrival) -->
            <Ellipse x:Name="PulseRing"
                     Width="32" Height="32"
                     Stroke="#4FC3F7" StrokeThickness="2"
                     Fill="Transparent"
                     Canvas.Left="0" Canvas.Top="0"
                     Opacity="0"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="PulseRingScale" ScaleX="1" ScaleY="1"/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Filled cursor body circle -->
            <Ellipse Width="12" Height="12"
                     Fill="#4FC3F7"
                     Canvas.Left="10" Canvas.Top="10"/>

            <!-- Downward-pointing triangle — the "pointer tip" below the circle -->
            <Polygon Points="10,23 22,23 16,33"
                     Fill="#4FC3F7"
                     Canvas.Left="0" Canvas.Top="0"/>
        </Canvas>

        <!-- ═══════════════════════════════════════════════════════════════
             Target highlight border — rounded rect drawn around the target
             ═══════════════════════════════════════════════════════════════ -->
        <Border x:Name="HighlightBorder"
                Visibility="Collapsed"
                CornerRadius="8"
                BorderBrush="#4FC3F7"
                BorderThickness="2"
                Background="#0A4FC3F7"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="HighlightScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             Instruction bubble — shows what the user should do
             ═══════════════════════════════════════════════════════════════ -->
        <Border x:Name="InstructionBubble"
                Visibility="Collapsed"
                CornerRadius="8"
                Background="#CC1A1A2E"
                Padding="10,8"
                Opacity="0">
            <TextBlock x:Name="InstructionTextBlock"
                       Foreground="White"
                       FontSize="13"
                       TextWrapping="Wrap"
                       MaxWidth="480"/>
        </Border>

        <!-- Dismiss button — top-right corner, always visible once overlay is shown -->
        <Button x:Name="DismissButton"
                Content="✕"
                Width="32" Height="32"
                Padding="0"
                FontSize="14"
                Foreground="White"
                Background="#CC1A1A2E"
                BorderBrush="#4FC3F7"
                BorderThickness="1"
                Cursor="Hand"
                Click="DismissButton_Click"
                Visibility="Collapsed"
                ToolTip="Dismiss (Escape)">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Canvas>
</Window>
